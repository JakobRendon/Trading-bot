OANDA_API_TOKEN=your_api_token_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice
OANDA_INSTRUMENTS=EUR_USD
OANDA_GRANULARITIES=M5,M15,H1,H4

# FTMO risk thresholds (all optional — defaults are set in config.py)
# Leave CHALLENGE_START_BALANCE blank to use current account balance on first run.
CHALLENGE_START_BALANCE=
RISK_STATE_PATH=risk_state.json
DAILY_LOSS_BUFFER_PCT=4
TOTAL_DRAWDOWN_BUFFER_PCT=9
MAX_REQUESTS_PER_DAY=1900
MAX_POSITION_ENTRIES_PER_DAY=1900
MAX_SIMULTANEOUS_POSITIONS=180
